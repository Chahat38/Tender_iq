# TenderScout AI - files that never belong in version control.

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets - env files only, never committed (.env.example is tracked)
.env

# SQLite databases (collector output; scraped data stays out of git)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Node (React front end, later stages)
node_modules/



.vercel/

# Vercel CLI local project link
.vercel/
