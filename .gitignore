# TenderScout AI - files that never belong in version control.

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets - env files only, never committed (.env.example is tracked)
.env

# SQLite databases (collector output; scraped data stays out of git)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Local run artifacts: per-source logs, DB backups and check screenshots.
# Only the bundled demo snapshot (collector/demo/db.tenderscout) is
# tracked on purpose; a stray `git add -A` must not push the backups.
collector/logs/
var/*.log
var/*.tenderscout
screenshots/
frontend/tsconfig.tsbuildinfo

# Node (React front end, later stages)
node_modules/



.vercel/

# Vercel CLI local project link
.vercel/
.vercel
.env*
