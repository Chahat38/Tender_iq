# TenderScout AI - environment template. Copy to `.env` (never committed)
# and adjust. Every variable is optional unless noted.

# --- Polite crawling (REQUIRED for any live collection) ---------------
# Contact address embedded in the crawler User-Agent; the compliance
# gate refuses to crawl without it.
CONTACT_EMAIL=crawler@example.org

# --- Storage -----------------------------------------------------------
# SQLite path used by the collector CLI and the read-only API
# (default: collector/tenderscout.db).
TENDERSCOUT_DB_PATH=collector/tenderscout.db

# Supabase/Postgres DSN. When set, the collector writes to Postgres and
# the API reads it instead of SQLite (see DECISIONS.md).
# DATABASE_URL=postgres://user:password@host:5432/postgres

# Where downloaded tender documents are stored (content-addressed
# subdirectories). Default: var/documents
# TENDERSCOUT_DOCUMENTS_DIR=var/documents

# --- AI stage ----------------------------------------------------------
# Optional: with an OPENAI_API_KEY the analysis pass uses an
# OpenAI-compatible chat completions endpoint and journals every call
# in analysis_runs; without it everything is deterministic (and the
# tests stay offline).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# TENDERSCOUT_LLM_MODEL=gpt-4o-mini

# --- Operational alerting ----------------------------------------------
# Slack incoming-webhook URL for collector operational alerts (3
# consecutive failed runs of a source). Without it alerts are logged
# and stored in operational_alerts only.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- API hardening ------------------------------------------------------
# Requests per client IP per minute for the read-only API
# (default 300; 0 disables the limiter).
# TENDERSCOUT_RATE_LIMIT=300

# Comma-separated browser origins allowed to call the API. The default
# ("*") suits the public, read-only Vercel demo; narrow it for a custom
# deployment, e.g. https://tenderiq-frontend.vercel.app
# TENDERSCOUT_CORS_ORIGINS=*

# --- Test-only ----------------------------------------------------------
# Real Postgres DSN for the `postgres`-marked RLS tests (never set in
# CI; those tests are deselected by pytest.ini by default).
# TEST_DATABASE_URL=postgres://...
